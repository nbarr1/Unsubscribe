# Unsubscribe Manager — example environment file.
#
# ─────────────────────────────────────────────────────────────────────────────
# YOUR MAIL PASSWORD DOES NOT GO IN THIS FILE.
#
# The IMAP app password is stored in your OS keychain (macOS Keychain, GNOME
# Keyring / libsecret, Windows Credential Vault) via `keytar`, written there by
# `unsub auth`. On a headless machine with no keychain, it falls back to a
# 0600-mode file inside the config directory. See ADR-001.
#
# Nothing in this file is secret, and no secret should ever be added to it.
# ─────────────────────────────────────────────────────────────────────────────

# IMAP server hostname. Gmail: imap.gmail.com
UNSUB_IMAP_HOST=imap.gmail.com

# IMAP port. 993 for implicit TLS, which is what you want.
UNSUB_IMAP_PORT=993

# The mailbox address you authenticate as.
UNSUB_IMAP_USER=you@example.com

# Comma-separated folders to scan. Gmail exposes labels as folders.
# "[Gmail]/All Mail" catches archived newsletters that INBOX alone would miss.
UNSUB_IMAP_FOLDERS=INBOX

# Override where the SQLite database and config live.
# Defaults to ~/.config/unsubscribe-manager (see ADR-004).
# UNSUB_DATA_DIR=/path/to/dir
